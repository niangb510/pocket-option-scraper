{
  "name": "pocket-option-scraper",
  "version": "1.0.0",
  "description": "Collecte de prix en temps réel (WebSocket via Puppeteer/CDP), agrégation en bougies et simulation de stratégies (paper trading)",
  "main": "scraper.js",
  "scripts": {
    "start": "node scraper.js",
    "analyze": "node analyze_data.js",
    "report": "node generate_rapport_complet.js",
